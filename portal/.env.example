# Every environment variable the portal reads. Copy to .env in this folder
# and fill in real values; .env is gitignored, this file is not - keep it
# valueless.
#
# docker-compose.yml passes the same .env into the portal container.


# Generate a fresh one per environment - never reuse your local key on the VPS.
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=''

# Only the literal string True turns debug on. Use True for local
# development; leave it False on the VPS, where a crash would otherwise show
# a traceback, local variables and every URL in the project to whoever hit it.
DJANGO_DEBUG=False

# Comma-separated, no spaces. Requests for any other host are refused with a
# 400.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# True on the VPS, where the portal sits behind an HTTPS reverse proxy: it
# trusts the proxy's X-Forwarded-Proto header, redirects to HTTPS, and marks
# the session and CSRF cookies Secure. Leave False locally - with it on, plain
# http://127.0.0.1:8000 redirects to an HTTPS address that doesn't exist.
DJANGO_HTTPS=False

# Note: LAB_MANAGER_URL and LAB_MANAGER_TOKEN are read by settings.py too, but
# live in the root .env (see the .env.example there): docker-compose.yml
# passes them to the portal and the lab manager alike. Unset, the lab list
# links straight to each lab's URL.

# Note: DJANGO_DB_PATH is deliberately not here. docker-compose.yml sets it on
# the portal service so it is always right inside the container; locally,
# leaving it unset puts db.sqlite3 next to manage.py.
