# Settings for docker-compose.yml itself, read from .env beside it. Copy to
# .env and fill in; .env is gitignored, this file is not - keep it valueless.
#
# Only needed on the VPS, where students start their own lab instances
# (`docker compose --profile labs up -d`). Leave it out on a laptop: the
# portal then links straight to each lab.
#
# Generate each secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"


# How the portal reaches the lab manager, on the internal labcontrol network.
LAB_MANAGER_URL=http://labmanager:8000

# Shared by the portal and the lab manager. Anything on labcontrol without it
# is refused.
LAB_MANAGER_TOKEN=

# Instances are served at https://<lab>-<8 hex>.<LAB_DOMAIN>/ - a wildcard DNS
# record and certificate must cover *.<LAB_DOMAIN>.
LAB_DOMAIN=pwnshop.uk

# Added by the host's Caddy to every request it forwards to the lab proxy, so
# the proxy can tell those apart from requests made from inside a lab. Must
# match the key in the host's Caddyfile.
LAB_PROXY_KEY=
